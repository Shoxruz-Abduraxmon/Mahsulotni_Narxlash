<div id="uploadSection" class="upload-page">
  <div class="step-cards">
    <div class="step-card step-card-upload" id="uploadCard">
      <div class="step-card-inner">
        <div class="step-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <h3>1. Excel faylni yuklang</h3>
        <p>.xlsx yoki .xls formatida</p>
        <input type="file" id="fileInput" name="excel" accept=".xlsx,.xls" hidden>
        <button type="button" id="selectBtn" class="btn btn-primary btn-block">Fayl tanlash</button>
        <a href="/template" class="btn btn-ghost btn-block template-link" download>Shablon yuklab olish</a>
        <div id="uploadStatus" class="upload-status"></div>
      </div>
    </div>

    <div class="step-card step-card-mapping" id="mappingCard" hidden>
      <div class="step-card-inner">
        <div class="step-icon step-icon-mapping">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </div>
        <h3>2. Excel ustunlarini bog'lang</h3>
        <p class="mapping-hint">Exceldek: ustunlar yonma-yon. Har bir ustun ostidan tanlang — pastda jadval ko‘rinadi.</p>

        <div class="invoice-meta">
          <label for="invoiceNameInput">Faktura nomi</label>
          <input type="text" id="invoiceNameInput" class="invoice-input" placeholder="Faktura nomi" autocomplete="off">
          <span class="mapping-file">Fayl: <strong id="mappingFileName">—</strong></span>
        </div>

        <div id="mappingList" class="mapping-list" role="list"></div>

        <div class="preview-block">
          <h4 class="preview-title">Excel ko‘rinishi (birinchi qatorlar)</h4>
          <div id="previewTableWrap" class="preview-table-wrap"></div>
        </div>

        <p class="mapping-note">Kelgan narx yoki Prihod summa majburiy. ✓ — avtomatik to‘g‘ri, ? — tekshiring.</p>

        <div class="mapping-actions">
          <button type="button" id="mappingCancelBtn" class="btn btn-ghost">Bekor</button>
          <button type="button" id="mappingSubmitBtn" class="btn btn-primary">Davom etish →</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="pricingSection" class="pricing-page" hidden>
  <div class="pricing-toolbar">
    <div class="toolbar-left">
      <div class="invoice-badge-wrap">
        <span class="toolbar-label">Faktura:</span>
        <strong id="invoiceBadge">—</strong>
      </div>
      <div class="percent-buttons">
        <span class="toolbar-label">Markup:</span>
        <button type="button" class="btn-percent active" data-percent="10">10%</button>
        <button type="button" class="btn-percent" data-percent="15">15%</button>
        <button type="button" class="btn-percent" data-percent="20">20%</button>
      </div>
    </div>
    <div class="toolbar-actions">
      <span class="progress-text" id="progressText">0 / 0</span>
      <button type="button" id="visibilityToggleBtn" class="btn btn-secondary" aria-expanded="false" aria-haspopup="dialog" aria-controls="visibilityOverlay">Maydonlar</button>
      <div class="export-mode" title="Shtrix va MXIK har doim Excelda chiqadi">
        <label><input type="radio" name="exportMode" value="visible" checked> Ko'rinish</label>
        <label><input type="radio" name="exportMode" value="full"> To'liq</label>
      </div>
      <button type="button" id="applyAllBtn" class="btn btn-secondary">Barchasiga qo'llash</button>
      <button type="button" id="exportBtn" class="btn btn-success">Excel yuklab olish</button>
      <button type="button" id="newFileBtn" class="btn btn-ghost">Yangi fayl</button>
    </div>
  </div>

  <div class="product-cards-grid" id="pricingBody"></div>

  <div id="visibilityOverlay" class="vis-overlay" hidden>
    <div id="visibilityPanel" class="vis-modal" role="dialog" aria-modal="true" aria-labelledby="visModalTitle" tabindex="-1"></div>
  </div>
</div>
